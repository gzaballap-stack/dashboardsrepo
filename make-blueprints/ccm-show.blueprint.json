{
    "name": "CCM - Show → Supabase",
    "flow": [
        {
            "id": 1,
            "module": "app#call-center-mastery-qeqot5:watchEventsManualPlacement",
            "version": 1,
            "parameters": {
                "__IMTHOOK__": 0
            },
            "mapper": {},
            "metadata": {
                "designer": { "x": 0, "y": 0 },
                "restore": {
                    "parameters": {
                        "__IMTHOOK__": {
                            "data": { "editable": "false" },
                            "label": "Show Webhook — create new and point GHL here"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTHOOK__",
                        "type": "hook:app#call-center-mastery-qeqot53",
                        "label": "Webhook",
                        "required": true
                    }
                ]
            }
        },
        {
            "id": 2,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": false,
                "useNewZLibDeCompression": true
            },
            "mapper": {
                "url": "https://REPLACE_WITH_YOUR_RAILWAY_URL/api/webhooks",
                "serializeUrl": false,
                "method": "POST",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer REPLACE_WITH_YOUR_API_KEY"
                    },
                    {
                        "name": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "qs": [],
                "bodyType": "raw",
                "parseResponse": false,
                "authUser": "",
                "authPass": "",
                "timeout": "",
                "shareCookies": false,
                "ca": "",
                "useMtls": false,
                "contentType": "application/json",
                "data": "{\"event_type\": \"show\", \"client_name\": \"{{trim(1.location.name)}}\", \"ghl_contact_id\": \"{{1.contact_id}}\", \"occurred_at\": \"{{formatDate(now; \\\"YYYY-MM-DDTHH:mm:ss\\\")}}\", \"ad_platform\": \"{{1.customData.`Ad Platform`}}\", \"campaign_id\": \"{{1.customData.`Campaign ID`}}\", \"campaign_name\": \"{{1.customData.`Campaign Name`}}\", \"adset_id\": \"{{1.customData.`Ad Set ID`}}\", \"adset_name\": \"{{1.customData.`Ad Set Name`}}\", \"ad_id\": \"{{1.customData.`Ad ID`}}\", \"ad_name\": \"{{1.customData.`Ad Name`}}\", \"utm_source\": \"{{1.customData.`UTM Source`}}\", \"utm_medium\": \"{{1.customData.`UTM Medium`}}\", \"utm_campaign\": \"{{1.customData.`UTM Campaign`}}\", \"utm_content\": \"{{1.customData.`UTM Content`}}\", \"utm_term\": \"{{1.customData.`UTM Term`}}\", \"referrer_url\": \"{{1.customData.`Referrer URL`}}\"}"
            },
            "metadata": {
                "designer": { "x": 300, "y": 0, "name": "Send to Supabase" }
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": { "orphans": [] },
        "zone": "eu1.make.com"
    }
}
